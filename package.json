{
  "name": "dsh-intent-debt-radar",
  "version": "0.2.3",
  "description": "DSH plugin: track unfulfilled promises in a conversation — the things you said you'd do later — as interest-bearing debt, across sessions.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "intent",
    "promise",
    "follow-up",
    "todo",
    "reminder"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm test && npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonefora11/dsh-intent-debt-radar.git"
  },
  "homepage": "https://github.com/nonefora11/dsh-intent-debt-radar#readme",
  "bugs": {
    "url": "https://github.com/nonefora11/dsh-intent-debt-radar/issues"
  }
}
